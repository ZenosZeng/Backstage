+def replace_with_retry(source: Path, target: Path) -> None:
+    """把 source 改名覆盖到 target，跨过 Windows 的瞬时占用。
+
+    Windows 上刚写完的文件或目录可能被杀毒或索引进程短暂持有句柄，此时
+    MoveFileEx 返回 WinError 5（拒绝访问），而目标其实已经不存在或被删除。
+    实测本机 40 项同步回归中约 1/15 次会命中，且真实同步会因此停在"部分
+    内容已替换"的状态；短暂重试可跨过这个窗口，非 Windows 平台通常一次成功。
+    """
+    for attempt in range(1, 6):
+        try:
+            os.replace(source, target)
+            return
+        except OSError:
+            if attempt == 5:
+                raise
+            time.sleep(0.05 * attempt)
+
